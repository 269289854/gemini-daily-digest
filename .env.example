# Server binding and public origin
SERVER_BIND_ADDR=127.0.0.1:8080
PUBLIC_BASE_URL=http://localhost:5173

# PostgreSQL connection string (isolated database recommended)
DATABASE_URL=postgres://digest_user:change_me@127.0.0.1:5432/gemini_digest

# Optional Redis URL for singleflight locks and source freshness cache (falls back to in-memory if empty)
REDIS_URL=

# 32-byte Base64 master key used to encrypt user API keys and SMTP credentials (AES-256-GCM)
# Generate with: openssl rand -base64 32
APP_MASTER_KEY_B64=REPLACE_WITH_32_BYTE_BASE64_KEY

# Authentication mode: "dev_bypass" (127.0.0.1 local dev only) or "oidc" (production)
AUTH_MODE=dev_bypass
OIDC_ISSUER_URL=https://auth.example.com/application/o/gemini-digest/
OIDC_CLIENT_ID=replace-with-oidc-client-id
OIDC_AUDIENCE=replace-with-oidc-client-id

# NIO & resource hard limits
TOKIO_WORKER_THREADS=2
PG_MAX_CONNECTIONS=5
MAX_FEED_BYTES=2097152
GLOBAL_FETCH_CONCURRENCY=4
SOURCE_FRESHNESS_TTL_SECS=900
ITEM_BODY_RETENTION_DAYS=180

# Optional comma-separated host allowlist for internal AI gateways (e.g. host.docker.internal)
SSRF_ALLOWLIST_HOSTS=

# Optional outbound HTTP/SOCKS5 proxy for upstream collectors
OUTBOUND_PROXY_URL=

# Logging filter
RUST_LOG=info,digest_server=debug,digest_core=debug
